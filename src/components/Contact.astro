---
import Flourish from './Flourish.astro';
import MessageIcon from './MessageIcon.astro';
import { site, whatsappLink } from '../data/site';
const whatsapp = whatsappLink('Hello little glow, I would love to find a little glow.');
---

<section class="section contact page" id="contact" aria-labelledby="contact-title" data-reveal="group">
  <h2 id="contact-title" data-reveal>
    found something you love?<Flourish />
  </h2>
  <p data-reveal style="--delay: calc(3 * var(--motion-stagger))">Get in touch to order your favourite candle, discuss a custom design or choose a special gift.</p>
  {whatsapp && (
    <a class="button button-message" data-reveal style="--delay: calc(4 * var(--motion-stagger))" href={whatsapp} target="_blank" rel="noreferrer">
      <MessageIcon />
      <span>Message us on WhatsApp</span>
    </a>
  )}
  {site.instagramUrl && <p class="contact-more" data-reveal style="--delay: calc(4 * var(--motion-stagger))">or find us on <a href={site.instagramUrl} target="_blank" rel="noreferrer">Instagram</a></p>}
</section>
