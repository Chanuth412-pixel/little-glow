---
import CandleLine from './CandleLine.astro';
---

<section class="section story" id="story" aria-labelledby="story-title">
  <div class="page" data-reveal="group">
    <CandleLine />
    <h2 id="story-title" data-reveal style="--delay: calc(2 * var(--motion-stagger))">made with care, and a little curiosity.</h2>
    <p data-reveal style="--delay: calc(3 * var(--motion-stagger))">Little Glow began with a love for chemistry and beautiful little things.</p>
  </div>
</section>
