---
import { Image } from 'astro:assets';
import { collections } from '../data/collections';
import { whatsappLink } from '../data/site';
---

<section class="section page" id="candles" aria-labelledby="candles-title">
  <h2 id="candles-title" data-reveal>find your favourite little glow.</h2>
  <ul class="candle-grid">
    {collections.map((item) => {
      const ask = whatsappLink("Hello little glow, I'd like to know more about " + item.name + '.');
      const details = (
        <Fragment>
          <div class="candle-photo" data-photo-reveal>
            <Image src={item.image} alt={item.alt} style={{ "object-position": item.focus }} widths={[400, 640, 900]} sizes="(max-width: 560px) calc(100vw - 36px), (max-width: 860px) calc(100vw - 48px), 33vw" />
          </div>
          <h3>{item.name}</h3>
          <p>{item.description}</p>
        </Fragment>
      );
      return (
        <li class="candle">
          {ask ? (
            <a class="candle-link" href={ask} target="_blank" rel="noreferrer">
              {details}
              <span class="text-link">Ask about {item.name}</span>
            </a>
          ) : details}
        </li>
      );
    })}
  </ul>
</section>

<script>
  if (typeof IntersectionObserver === 'function') {
    const visibleRatio = 0.2;
    const observer = new IntersectionObserver(entries => {
      for (const { target, intersectionRatio } of entries) {
        if (intersectionRatio < visibleRatio) continue;

        target.setAttribute('data-photo-reveal', 'visible');
        observer.unobserve(target);
      }
    }, { threshold: visibleRatio });

    document.querySelectorAll('[data-photo-reveal]').forEach(photo => {
      photo.setAttribute('data-photo-reveal', 'pending');
      observer.observe(photo);
    });
  }
</script>
