---
import { Image } from 'astro:assets';
import { collections } from '../data/collections';
import { whatsappLink } from '../data/site';
---

<section class="section page" id="candles" aria-labelledby="candles-title">
  <div class="section-head">
    <h2 id="candles-title">little things, <em>made with love.</em></h2>
    <p>Every candle is poured, unmoulded and finished by hand.</p>
  </div>
  <ul class="candle-grid">
    {collections.map((item) => {
      const ask = whatsappLink(`Hello little glow, I'd like to know more about ${item.name}.`);
      return (
        <li class="candle">
          <div class="candle-photo">
            <Image src={item.image} alt={item.alt} style={`object-position: ${item.focus}`} widths={[400, 640, 900]} sizes="(max-width: 560px) 100vw, (max-width: 860px) 50vw, 33vw" />
          </div>
          <h3>{item.name}</h3>
          <p>{item.description}</p>
          {ask && <a class="text-link" href={ask} target="_blank" rel="noreferrer">Ask about {item.name}</a>}
        </li>
      );
    })}
  </ul>
</section>
