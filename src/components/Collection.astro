---
import { Image } from 'astro:assets';
import { collections } from '../data/collections';
---

<section class="section page" id="candles" aria-labelledby="candles-title">
  <h2 id="candles-title">little things, made with love.</h2>
  <ul class="candle-grid">
    {collections.map((item) => (
      <li class="candle">
        <div class="candle-photo">
          <Image src={item.image} alt={item.alt} style={`object-position: ${item.focus}`} widths={[400, 640, 900]} sizes="(max-width: 860px) 100vw, 33vw" />
        </div>
        <h3>{item.name}</h3>
        <p>{item.description}</p>
      </li>
    ))}
  </ul>
</section>
