---
import { Image } from 'astro:assets';
import roseImage from '../pages/assets/images/hero-rose.jpg.jpg';
import teddyImage from '../pages/assets/images/hero-teddy.jpg.jpeg';
---

<section class="hero" aria-labelledby="hero-title">
  <p class="eyebrow">hand-poured, with heart</p>
  <h1 id="hero-title"><span>a little science,</span><span><em>a lot of love.</em></span></h1>
  <p class="hero-copy">Hand-poured candles, thoughtfully made for life's little moments.</p>
  <div class="hero-images">
    <div class="image-frame hero-rose"><Image src={roseImage} alt="Pink rose-shaped candle on a marble tray" loading="eager" /></div>
    <div class="image-frame hero-teddy"><Image src={teddyImage} alt="Pale pink teddy bear candle holding a heart" /></div>
  </div>
  <a class="text-link hero-cta" href="#collection">discover something lovely <span class="arrow" aria-hidden="true">→</span></a>
</section>
