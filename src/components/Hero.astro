---
import { Image } from 'astro:assets';
import Flourish from './Flourish.astro';
import litRose from '../pages/assets/images/hero-teddy.jpg.jpeg';
import { site } from '../data/site';
---

<section class="hero page" aria-labelledby="hero-title">
  <div>
    <h1 id="hero-title">
      <span>a little science,</span>
      <span><em><span class="flourish-wrap">a lot of love.<Flourish /></span></em></span>
    </h1>
    <p>{site.description}</p>
  </div>
  <div class="hero-photo">
    <Image
      src={litRose}
      alt="A pale pink rose candle, lit, glowing from the centre of its petals"
      widths={[480, 720, 960, 1200]}
      sizes="(max-width: 560px) calc(100vw - 36px), (max-width: 860px) calc(100vw - 48px), 50vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>
