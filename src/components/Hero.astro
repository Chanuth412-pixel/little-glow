---
import { Image } from 'astro:assets';
import litRose from '../pages/assets/images/hero-teddy.jpg.jpeg';
import { site, whatsappLink } from '../data/site';
const order = whatsappLink('Hello little glow, I would like to order a candle.');
---

<section class="hero page" aria-labelledby="hero-title">
  <div>
    <h1 id="hero-title"><span>a little science,</span><span><em>a lot of love.</em></span></h1>
    <p>{site.description}</p>
    {order
      ? <a class="button" href={order} target="_blank" rel="noreferrer">Order on WhatsApp</a>
      : <a class="button" href="#candles">See the candles</a>}
  </div>
  <div class="hero-photo">
    <Image
      src={litRose}
      alt="A pale pink rose candle, lit, glowing from the centre of its petals"
      widths={[480, 720, 960, 1200]}
      sizes="(max-width: 860px) 100vw, 50vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>
