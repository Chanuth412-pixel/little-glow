---
import { orderSteps } from '../data/site';
---

<section class="section page order" id="order" aria-labelledby="order-title">
  <div class="section-head">
    <h2 id="order-title">how to <em>order.</em></h2>
  </div>
  <ol class="steps">
    {orderSteps.map((step) => (
      <li>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
</section>
