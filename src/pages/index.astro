---
import { Image } from 'astro:assets';
import peonyImage from './assets/images/hero-rose.jpg.jpg';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Collection from '../components/Collection.astro';
import OurStory from '../components/OurStory.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource-variable/dm-sans/index.css';
import '../styles/global.css';

const title = `${site.name} Hand-poured sculpted candles`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <Collection />
      <OurStory />
      <Contact />
      <div class="closing page">
        <blockquote class="closing-quote">
          <p>?Each candle brings together curiosity, creativity, and careful craftsmanship, thoughtfully hand-poured in small batches.?</p>
        </blockquote>
        <Image
          class="closing-photo"
          src={peonyImage}
          alt="Pink peony candle on a white marble tray beside a gold wick trimmer"
          widths={[400, 520, 780, 1040]}
          sizes="(max-width: 860px) 100vw, 50vw"
          loading="lazy"
        />
      </div>
    </main>
    <Footer />
  </body>
</html>
