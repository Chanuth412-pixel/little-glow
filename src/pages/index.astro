---
import { Image } from 'astro:assets';
import peonyImage from './assets/images/hero-rose.jpg.jpg';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Collection from '../components/Collection.astro';
import OurStory from '../components/OurStory.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource-variable/dm-sans/index.css';
import displayRegular from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url';
import displayItalic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-italic.woff2?url';
import wordmarkFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import bodyFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';

const title = `${site.name} Hand-poured sculpted candles`;
const baseUrl = import.meta.env.BASE_URL;
const faviconUrl = (baseUrl.endsWith('/') ? baseUrl : baseUrl + '/') + 'favicon.svg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {[displayRegular, displayItalic, wordmarkFont, bodyFont].map(font => (
      <link rel="preload" href={font} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('DOMContentLoaded', () => {
        const targets = document.querySelectorAll('[data-reveal]');
        if (typeof IntersectionObserver !== 'function') {
          targets.forEach(target => target.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const target = entry.target;
            target.classList.add('is-visible');
            if (target.dataset.reveal === 'group') {
              target.querySelectorAll('[data-reveal]').forEach(child => child.classList.add('is-visible'));
            }
            observer.unobserve(target);
          });
        }, { threshold: 0, rootMargin: '0px 0px -30% 0px' });
        targets.forEach(target => {
          if (!target.parentElement.closest('[data-reveal="group"]')) observer.observe(target);
        });
        document.documentElement.classList.add('reveal-ready');

        const sections = Array.from(document.querySelectorAll('[data-section-nav] a')).flatMap(link => {
          const section = document.getElementById(link.hash.slice(1));
          return section ? [{ link, section }] : [];
        });
        const viewport = document.documentElement;
        const atEnd = () => scrollY > 0 && Math.ceil(scrollY + viewport.clientHeight) >= viewport.scrollHeight;
        let current;
        let sectionObserver;
        const inView = new Set();
        let wasAtEnd = false;
        function markCurrent() {
          wasAtEnd = atEnd();
          const middle = viewport.clientHeight / 2;
          const active = wasAtEnd ? sections.at(-1) :
            sections.findLast(({ section }) => inView.has(section)) ??
            sections.findLast(({ section }) => section.getBoundingClientRect().top <= middle);
          const next = scrollY > 0 ? active?.link : undefined;
          if (current === next) return;
          current?.removeAttribute('aria-current');
          next?.setAttribute('aria-current', 'true');
          current = next;
        }
        function observeSections() {
          sectionObserver?.disconnect();
          // IntersectionObserver percentage margins use width. Use 45% of height in pixels.
          const margin = -viewport.clientHeight * 0.45 + "px";
          inView.clear();
          sectionObserver = new IntersectionObserver(entries => {
            entries.forEach(({ target, isIntersecting }) => {
              if (isIntersecting) inView.add(target);
              else inView.delete(target);
            });
            markCurrent();
          }, { rootMargin: margin + ' 0px ' + margin + ' 0px' });
          sections.forEach(({ section }) => sectionObserver.observe(section));
        }
        observeSections();
        window.addEventListener('resize', observeSections);
        let revealedAtEnd = false;
        window.addEventListener('scroll', () => {
          const reachedEnd = atEnd();
          if (reachedEnd && !revealedAtEnd) {
            targets.forEach(target => target.classList.add('is-visible'));
            observer.disconnect();
            revealedAtEnd = true;
          }
          if (reachedEnd !== wasAtEnd || (scrollY === 0 && current)) markCurrent();
        }, { passive: true });
      }, { once: true });
    </script>
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <Collection />
      <OurStory />
      <div class="closing page" data-reveal="group">
        <blockquote class="closing-quote" data-reveal>
          <p>“Each candle brings together curiosity, creativity, and careful craftsmanship, thoughtfully hand-poured in small batches.”</p>
        </blockquote>
        <div class="closing-photo" data-reveal="curtain" style="--delay: var(--motion-stagger)">
          <Image
            src={peonyImage}
            alt="Pink peony candle on a white marble tray beside a gold wick trimmer"
            widths={[400, 520, 780, 1040]}
            sizes="(max-width: 560px) calc(100vw - 36px), (max-width: 860px) calc(100vw - 48px), 50vw"
            loading="lazy"
          />
        </div>
      </div>
      <Contact />
    </main>
    <Footer />
  </body>
</html>
